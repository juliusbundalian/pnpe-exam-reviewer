# Developer toolchain only. No credentials are needed for the localhost emulator.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# For a deliberately reviewed production command, unset FIRESTORE_EMULATOR_HOST
# and provide GOOGLE_APPLICATION_CREDENTIALS outside this checkout.
# Never put Admin credentials in Expo/client environment variables.

# Mobile native configuration files (NOT Admin ADC); absolute paths supported.
# Owner files are ignored and must match com.pnpe.exam.reviewer on both platforms.
# Never commit file contents or use an Admin service account as either file.
# Both files must exist to enable app/auth native configuration. Missing files
# produce a public-only build. Rebuild the native app after changing these paths.
GOOGLE_SERVICES_ANDROID=/absolute/local/path/google-services.json
GOOGLE_SERVICES_IOS=/absolute/local/path/GoogleService-Info.plist
EXPO_PUBLIC_FIREBASE_MODE=configured
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# For isolated native emulator tests: MODE=emulator, PROJECT_ID=demo-pnpe.
# A named SDK app uses Auth :9099 and Firestore :8080, never the owner's default app.
# Remote Config uses bundled defaults in this mode; it is NOT live Remote Config.
# Use 127.0.0.1 for iOS simulator or 10.0.2.2 for Android emulator.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# Re-run expo prebuild and restart Metro with this same environment after changes.
# To verify public-only startup, unset BOTH GOOGLE_SERVICES_* variables.
