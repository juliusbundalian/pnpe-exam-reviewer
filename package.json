{
  "name": "pnpe-exam-reviewer",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "overrides": {
    "@google-cloud/firestore-api@0.2.0": {
      "google-gax@5.0.8": {
        "google-auth-library": "10.9.1"
      }
    }
  },
  "scripts": {
    "process:references": "tsx tools/questions/cli.ts process",
    "validate:questions": "tsx tools/questions/cli.ts validate",
    "import:questions": "tsx tools/questions/cli.ts import",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-pnpe \"jest --config jest.integration.config.cjs --runInBand\"",
    "test:references": "jest --runInBand --config jest.references.config.cjs",
    "test:unit": "jest --runInBand",
    "typecheck": "npm run typecheck:tools && npm run typecheck:mobile",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "typecheck:mobile": "tsc --noEmit -p tsconfig.mobile.json",
    "test:mobile": "jest --config jest.mobile.config.cjs --runInBand",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "26.4.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/auth": "26.4.0",
    "@react-native-firebase/firestore": "26.4.0",
    "@react-native-firebase/remote-config": "26.4.0",
    "expo": "57.0.27",
    "expo-build-properties": "57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.12",
    "expo-router": "57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@firebase/rules-unit-testing": "5.0.2",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.1",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "9.39.5",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.32.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "prettier": "3.9.9",
    "react-test-renderer": "19.2.3",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
